<?xml version="1.0" encoding="utf-8"?>
<!-- Children of EffortCardView (a vertical LinearLayout): the effort points replace the old giant pace. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/effortMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:textColor="@color/ink_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/trenchBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_pill_trench"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_fire" />

        <TextView
            android:id="@+id/trenchBadgeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/cream_card"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/effortPoints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textColor="@color/seed"
        android:textSize="64sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/effortLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:letterSpacing="0.12"
        android:text="@string/effort_points_label"
        android:textAllCaps="true"
        android:textColor="@color/ink_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/effortDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/ink_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/effortNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/ink_muted"
        android:textSize="12sp"
        android:textStyle="italic"
        android:visibility="gone" />

    <TextView
        android:id="@+id/effortFeelings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="4"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="italic"
        android:visibility="gone" />
</merge>
